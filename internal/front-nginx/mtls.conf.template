server {
  server_name ${FRONT_SERVER_NAME};
  listen ${FRONT_MTLS_PORT} ssl;

  ssl_certificate ${FRONT_MTLS_CERT_FILE};
  ssl_certificate_key ${FRONT_MTLS_KEY_FILE};
  ssl_client_certificate ${FRONT_MTLS_CA_FILE};
  ssl_verify_client on;
  ssl_verify_depth ${FRONT_MTLS_VERIFY_DEPTH};
  ssl_session_timeout 10m;
  ssl_session_cache shared:SSL:10m;
  ssl_protocols TLSv1.2 TLSv1.3;

  client_header_buffer_size 512k;
  large_client_header_buffers 4 512k;
  client_max_body_size 12m;

  location / {
    return 404 "mTLS endpoints only. Use the regular ingress for non-mTLS traffic.";
  }

  location ${FRONT_BASE_PATH}/api/mtls {
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-SSL-Client-Verify $ssl_client_verify;
    proxy_set_header X-SSL-Client-DN $ssl_client_s_dn;
    proxy_set_header X-SSL-Client-Serial $ssl_client_serial;
    proxy_set_header X-SSL-Client-Fingerprint $ssl_client_fingerprint;
    proxy_set_header X-SSL-Client-Issuer $ssl_client_i_dn;
    proxy_set_header X-SSL-Client-Cert $ssl_client_escaped_cert;
    rewrite ^${FRONT_BASE_PATH}(/api/mtls.*)$ $1 break;
    proxy_pass http://backend;
    proxy_redirect off;
  }
}
