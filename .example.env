# Set only the path to the certificate generated with mkcert.
NODE_EXTRA_CA_CERTS="../rootCA.pem"
# Application runtime environment: 'development' or 'production'.
# Default: production
NODE_ENV=development

# Public service host without a scheme. This is the source of truth for
# nginx/Traefik and the application runtime URL. Example: id.example.com
ID_HOST=local.encvoy.com

# Path under which ID is published. Leave empty for a dedicated domain,
# or use a path such as /id for a shared domain.
ID_BASE_PATH=

# Override only when the public runtime URL cannot be expressed as
# https://${ID_HOST}${ID_BASE_PATH}. Leave empty for a standard installation.
DOMAIN=

# Administrator login.
# Default: 'root'
ADMIN_LOGIN=
# Administrator password.
# Default: 'changethis'
ADMIN_PASSWORD=

# Number of days before a user profile is deleted.
# Default: 30 days
DELETE_PROFILE_AFTER_DAYS=

# Unique application ID.
# Required.
# Generating a UUID is recommended.
CLIENT_ID=client-id-uuid

# PostgreSQL
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=mydb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Format: 'postgresql://username:password@host:port/database_name'
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

# Redis configuration.
# Default: 6379
REDIS_PORT=
# Default: '127.0.0.1'
REDIS_HOST=

# Secret used to sign and verify cookies.
OIDC_COOKIE_SECRET=

# Session TTL in seconds.
# Default: 86400
OIDC_SESSION_TTL=

# Rate-limit configuration.
# Default: 15
RATE_LIMIT=
# Default: 900
RATE_LIMIT_TTL_SEC=

# Log levels emitted to the console.
# Default: 'log warn error'
CONSOLE_LOG_LEVELS=
