// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
  binaryTargets   = ["native", "darwin", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())

  // Password
  hashed_password          String
  password_updated_at      DateTime @default(now())
  password_change_required Boolean?

  // Settings
  locale          String?
  profile_privacy Boolean @default(true)
  card_url        String  @unique @default(cuid())
  card_active     Boolean @default(false)

  // Service fields
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted    DateTime?

  profile_values       UserProfileValue[]

  // Relations
  roles            Role[]
  scopes           Scopes[]
  externalAccounts ExternalAccount[]
  searchHistories  SearchHistory[]

  org_id       String?
  organization Client? @relation(fields: [org_id], references: [client_id], onUpdate: Cascade, onDelete: SetNull)

  folder_id         String
  folder            Folder             @relation(fields: [folder_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  notificationReads NotificationRead[]

  /// Favorite applications
  favorite_clients FavoriteClients[]

  // RBAC
  rbacGroupMembers RbacGroupMember[]
  rbacAssignments  RbacAssignment[]
  @@index([folder_id])
  @@index([org_id])
}

model ProfileField {
  id                        String                @id @default(cuid())
  key                       String                @unique
  organization_id           String?
  organization              Client?               @relation("ClientProfileFields", fields: [organization_id], references: [client_id], onUpdate: Cascade, onDelete: Cascade)
  title                     Json                  @db.JsonB
  value_type                ProfileFieldValueType @default(STRING)
  mapping_vcard             String?
  default_value             Json?                 @db.JsonB
  default_public            Int                   @default(0)
  editable                  Boolean               @default(true)
  required                  Boolean               @default(false)
  unique                    Boolean               @default(false)
  validate_on_authorization Boolean               @default(false)
  active                    Boolean               @default(true)
  created_at                DateTime              @default(now())
  updated_at                DateTime              @updatedAt

  values                    UserProfileValue[]
  validations               ProfileFieldValidation[]
  required_by_clients       ClientRequiredProfileField[]
  oidc_scope_group_fields   OidcScopeGroupField[]

  @@index([organization_id, active])
  @@index([organization_id, key])
}

model UserProfileValue {
  id String @id @default(cuid())

  user_id          String
  user             User         @relation(fields: [user_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  profile_field_id String
  profile_field    ProfileField @relation(fields: [profile_field_id], references: [id], onUpdate: Cascade, onDelete: Cascade)

  value      Json?    @db.JsonB
  public     Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, profile_field_id])
  @@index([user_id])
  @@index([profile_field_id])
  @@index([profile_field_id, public])
}

model ProfileFieldValidation {
  profile_field_id   String
  profile_field      ProfileField   @relation(fields: [profile_field_id], references: [id], onDelete: Cascade)
  rule_validation_id String
  rule_validation    RuleValidation @relation(fields: [rule_validation_id], references: [id], onDelete: Cascade)

  @@id([profile_field_id, rule_validation_id])
}

model ClientType {
  id   String @id @default(cuid())
  name Json   @db.JsonB

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  clients Client[]
}

model Client {
  avatar                        String?
  cover                         String?
  cover_mode                    String   @default("")
  created_at                    DateTime @default(now())
  updated_at                    DateTime @updatedAt
  description                   String?
  domain                        String?
  name                          Json?    @db.JsonB
  catalog_name                  Json?    @db.JsonB
  catalog                       Boolean  @default(false)
  mini_widget                   Boolean  @default(false)
  authorize_only_admins         Boolean  @default(false)
  authorize_only_employees      Boolean  @default(false)
  authorize_auto_by_session     Boolean  @default(false)
  show_avatar_in_widget         Boolean  @default(false)
  hide_avatars_of_big_providers Boolean  @default(false)
  hide_widget_header            Boolean  @default(false)
  hide_widget_footer            Boolean  @default(false)
  hide_widget_create_account    Boolean  @default(false)
  widget_title                  Json     @default("{\"ru-RU\":\"WIDGET_APP_NAME\"}") @db.JsonB
  widget_colors                 Json     @default("{}") @db.JsonB
  widget_info                   String   @default("")
  widget_info_out               String   @default("")
  required_providers_ids        String[] @default([])

  //oidc
  client_id                          String   @id @unique @default(cuid())
  client_secret                      String
  redirect_uris                      String[]
  post_logout_redirect_uris          String[]
  application_type                   String   @default("web")
  grant_types                        String[] @default(["authorization_code"])
  id_token_signed_response_alg       String   @default("RS256")
  request_uris                       String[] @default([])
  require_auth_time                  Boolean  @default(false)
  response_types                     String[] @default(["code"])
  subject_type                       String   @default("public")
  token_endpoint_auth_method         String   @default("client_secret_basic")
  introspection_endpoint_auth_method String   @default("client_secret_basic")
  revocation_endpoint_auth_method    String   @default("client_secret_basic")
  require_signed_request_object      Boolean  @default(false)
  access_token_ttl                   Int      @default(1800)
  refresh_token_ttl                  Int      @default(86400)

  roles                   Role[]
  scopes                  Scopes[]
  providerRelations       Provider_relations[]
  providers               Provider[]
  favorite_clients        FavoriteClients[]
  required_profile_fields ClientRequiredProfileField[]
  notifications           Notification[]

  // Application type
  type_id String?
  type    ClientType? @relation(fields: [type_id], references: [id], onUpdate: Cascade, onDelete: SetNull)

  // Parent client
  parent_id String?
  parent    Client?  @relation("ClientParent", fields: [parent_id], references: [client_id], onUpdate: Cascade, onDelete: Cascade)
  children  Client[] @relation("ClientParent")

  clientInvitations ClientInvitation[]

  // Folder
  folder_id String?
  folder    Folder? @relation("ClientFolder", fields: [folder_id], references: [id], onUpdate: Cascade, onDelete: Cascade)

  // RBAC
  rbacResources                     RbacResource[]
  rbacRoles                         RbacRole[]
  rbacGroups                        RbacGroup[]
  applicationAccessGroups           ApplicationAccessGroup[] @relation("ApplicationAccessGroupApplication")
  users                             User[]
  folders                           Folder[]                 @relation("FolderOwner")
  oidc_scope_groups                 OidcScopeGroup[]         @relation("ClientOidcScopeGroups")
  profile_fields                    ProfileField[]           @relation("ClientProfileFields")
  rule_validations                  RuleValidation[]         @relation("ClientRuleValidations")
  @@unique([client_id, parent_id])
}

model OidcScopeGroup {
  id              String @id @default(cuid())
  organization_id String
  organization    Client @relation("ClientOidcScopeGroups", fields: [organization_id], references: [client_id], onUpdate: Cascade, onDelete: Cascade)

  name        String
  icon        String?
  title       Json     @db.JsonB
  description Json?    @db.JsonB
  active      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  fields OidcScopeGroupField[]

  @@unique([organization_id, name])
  @@index([organization_id, active])
}

model OidcScopeGroupField {
  scope_group_id   String
  scope_group      OidcScopeGroup @relation(fields: [scope_group_id], references: [id], onDelete: Cascade)
  profile_field_id String
  profile_field    ProfileField   @relation(fields: [profile_field_id], references: [id], onUpdate: Cascade, onDelete: Cascade)

  claim_name String?
  order      Int     @default(0)

  @@id([scope_group_id, profile_field_id])
  @@unique([profile_field_id])
}

model FavoriteClients {
  id        String @id @default(cuid())
  user_id   String
  user      User   @relation(fields: [user_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  client_id String
  client    Client @relation(fields: [client_id], references: [client_id], onUpdate: Cascade, onDelete: Cascade)

  @@unique([user_id, client_id])
}

model SearchHistory {
  user_id    String             @id
  user       User               @relation(fields: [user_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  type       SearchHistoryTypes
  list       String[]
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt

  @@unique([user_id, type])
}

enum SearchHistoryTypes {
  log
  users
  clients
}

model EmailTemplates {
  id          String    @id @default(cuid())
  provider_id String?
  provider    Provider? @relation(fields: [provider_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  title       String
  action      String
  subject     String
  content     String
  locale      String
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@unique([provider_id, action, locale])
  @@index([provider_id, locale])
}

model Settings {
  id         String   @id @default(cuid())
  name       String   @unique
  title      String   @unique
  value      Json     @db.JsonB
  public     Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Role {
  id         String   @id @default(cuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  client_id  String
  client     Client   @relation(fields: [client_id], references: [client_id], onUpdate: Cascade, onDelete: Cascade)
  role       String
  blocked    Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, client_id])
  @@index([client_id, role])
}

model Scopes {
  id         String   @id @default(cuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  client_id  String
  client     Client   @relation(fields: [client_id], references: [client_id], onUpdate: Cascade, onDelete: Cascade)
  scopes     String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, client_id])
}

model ExternalAccount {
  id               String   @id @default(cuid())
  sub              String
  issuer           String?
  type             String
  user_id          String
  user             User     @relation(fields: [user_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  avatar           String?
  hashed_email     String?
  hashed_email_md5 String?
  label            String?
  profile_link     String?
  rest_info        Json?    @db.JsonB
  public           Int      @default(0)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  // Service marks
  last_active_provider_id String?
  last_active_provider    Provider? @relation(fields: [last_active_provider_id], references: [id], onUpdate: Cascade, onDelete: SetNull)
}

model Provider {
  id                String   @id @default(cuid())
  type              String
  is_public         Boolean  @default(false)
  password_required Boolean  @default(false)
  avatar            String?
  description       String?
  name              Json     @db.JsonB
  params            Json?    @db.JsonB
  default_public    Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Relation to Provider_relations
  providerRelations Provider_relations[]

  // Relation to Client
  client_id  String
  client     Client?  @relation(fields: [client_id], references: [client_id], onUpdate: Cascade, onDelete: Cascade)

  externalAccounts ExternalAccount[]
  email_templates  EmailTemplates[]
}

// Many-to-many relation table for Client and Provider
model Provider_relations {
  id          String   @id @default(cuid())
  provider_id String
  provider    Provider @relation(fields: [provider_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  client_id   String
  client      Client   @relation(fields: [client_id], references: [client_id], onUpdate: Cascade, onDelete: Cascade)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  index       Int      @default(0)
  groupe      String   @default("SMALL")

  @@unique([client_id, provider_id])
}

model Log {
  id          String   @id @default(cuid())
  date        DateTime @default(now()) @db.Timestamptz
  ip_address  String?
  user_id     String?
  client_id   String?
  device      String?
  event       String
  description String?
  details     Json     @db.JsonB
}

model RuleValidation {
  id              String   @id @default(cuid())
  organization_id String?
  organization    Client?  @relation("ClientRuleValidations", fields: [organization_id], references: [client_id], onUpdate: Cascade, onDelete: Cascade)
  active          Boolean  @default(true)
  title           Json     @db.JsonB
  error           Json     @db.JsonB
  regex           String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt()

  profile_fields ProfileFieldValidation[]

  @@unique([organization_id, title])
  @@index([organization_id])
}

// Many-to-many relation table for Client and ProfileField
model ClientRequiredProfileField {
  id               String       @id @default(cuid())
  client_id        String
  client           Client       @relation(fields: [client_id], references: [client_id], onUpdate: Cascade, onDelete: Cascade)
  profile_field_id String
  profile_field    ProfileField @relation(fields: [profile_field_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  created_at       DateTime     @default(now())

  @@unique([client_id, profile_field_id])
}

model ClientInvitation {
  id         String   @id @default(cuid())
  email      String
  client_id  String
  client     Client   @relation(fields: [client_id], references: [client_id], onUpdate: Cascade, onDelete: Cascade)
  created_at DateTime @default(now())

  @@unique([client_id, email])
}

enum NotificationTarget {
  ALL
  NEW_USERS
  EXISTING_USERS
  USER_LIST
}

model Notification {
  id         String             @id @default(cuid())
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt
  title      Json               @db.JsonB
  content    Json               @db.JsonB
  is_active  Boolean            @default(true)
  target     NotificationTarget @default(ALL)
  user_ids   String[]           @default([])
  client_id  String?
  client     Client?            @relation(fields: [client_id], references: [client_id], onUpdate: Cascade, onDelete: Cascade)
  reads      NotificationRead[]

  @@index([client_id, is_active, created_at])
  @@index([client_id, created_at])
}

model NotificationRead {
  id              String       @id @default(cuid())
  read_at         DateTime     @default(now())
  notification_id String
  notification    Notification @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  user_id         String
  user            User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([notification_id, user_id])
}

enum AuthMethodTypes {
  client_secret_basic
  client_secret_post
  client_secret_jwt
  private_key_jwt
  none
}

enum SigningAlgTypes {
  RS256
  PS256
}

enum GrantTypes {
  authorization_code
  implicit
  refresh_token
}

enum SubjectTypes {
  public
  pairwise
}

enum RegistrationPolicyVariants {
  allowed
  allowed_autoregistration_only
  disabled
}

enum ProfileFieldValueType {
  STRING
  TEXT
  BOOLEAN
  DATE
  DATETIME
  INTEGER
  NUMBER
  ENUM
  MULTI_ENUM
  JSON
  EMAIL
  PHONE
  URL
  IMAGE
}

model RbacResource {
  id          String   @id @default(cuid())
  client_id   String
  name        String
  description String?
  parent_id   String? // Resource hierarchy.
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  client      Client           @relation(fields: [client_id], references: [client_id], onUpdate: Cascade, onDelete: Cascade)
  parent      RbacResource?    @relation("ResourceHierarchy", fields: [parent_id], references: [id], onUpdate: Cascade, onDelete: SetNull)
  children    RbacResource[]   @relation("ResourceHierarchy")
  assignments RbacAssignment[]
}

model RbacRole {
  id          String   @id @default(cuid())
  client_id   String
  name        String
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  client      Client               @relation(fields: [client_id], references: [client_id], onUpdate: Cascade, onDelete: Cascade)
  assignments RbacAssignment[]
  permissions RbacRolePermission[]
}

model RbacGroup {
  id          String   @id @default(cuid())
  client_id   String
  name        String
  description String?
  folder_id   String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  client                  Client                   @relation(fields: [client_id], references: [client_id], onUpdate: Cascade, onDelete: Cascade)
  folder                  Folder                   @relation(fields: [folder_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  members                 RbacGroupMember[]        @relation("RbacGroupMembers")
  parent_groups           RbacGroupMember[]        @relation("RbacGroupParentGroups")
  assignments             RbacAssignment[]
  applicationAccessGroups ApplicationAccessGroup[]

  @@unique([id, client_id])
}

model ApplicationAccessGroup {
  organization_id String
  application_id  String
  group_id        String
  created_at      DateTime @default(now())
  created_by      String?

  application Client    @relation("ApplicationAccessGroupApplication", fields: [application_id, organization_id], references: [client_id, parent_id], onUpdate: Cascade, onDelete: Cascade)
  group       RbacGroup @relation(fields: [group_id, organization_id], references: [id, client_id], onUpdate: Cascade, onDelete: Cascade)

  @@id([organization_id, application_id, group_id])
  @@index([organization_id, group_id])
}

model RbacGroupMember {
  id              String  @id @default(cuid())
  parent_group_id String
  member_user_id  String?
  member_group_id String?

  parent_group RbacGroup  @relation("RbacGroupMembers", fields: [parent_group_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  member_user  User?      @relation(fields: [member_user_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  member_group RbacGroup? @relation("RbacGroupParentGroups", fields: [member_group_id], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@unique([parent_group_id, member_user_id])
  @@unique([parent_group_id, member_group_id])
}

model RbacAssignment {
  id          String   @id @default(cuid())
  resource_id String
  role_id     String
  user_id     String?
  group_id    String?
  created_at  DateTime @default(now())

  resource RbacResource @relation(fields: [resource_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  role     RbacRole     @relation(fields: [role_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  user     User?        @relation(fields: [user_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  group    RbacGroup?   @relation(fields: [group_id], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([resource_id, user_id])
  @@index([resource_id, group_id])
}

model RbacPermission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  rolePermissions RbacRolePermission[]
}

model RbacRolePermission {
  role_id       String
  permission_id String

  role       RbacRole       @relation(fields: [role_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  permission RbacPermission @relation(fields: [permission_id], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@id([role_id, permission_id])
}

model Folder {
  id          String   @id @default(cuid())
  client_id   String
  name        String
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  parent_id String?
  parent    Folder?  @relation("FolderHierarchy", fields: [parent_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  children  Folder[] @relation("FolderHierarchy")

  client  Client      @relation("FolderOwner", fields: [client_id], references: [client_id], onUpdate: Cascade, onDelete: Cascade)
  clients Client[]    @relation("ClientFolder")
  groups  RbacGroup[]
  users   User[]

  @@unique([client_id, parent_id, name])
  @@index([client_id, parent_id])
}
